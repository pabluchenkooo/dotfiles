{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "vim",
  "teammateMode": "tmux",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "ask": [
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh api:*)",
      "mcp__linear__save_issue",
      "mcp__linear__save_comment",
      "mcp__linear__save_document",
      "mcp__linear__save_project",
      "mcp__linear__save_milestone",
      "mcp__linear__save_initiative",
      "mcp__linear__save_status_update",
      "mcp__linear__save_diff_comment",
      "mcp__linear__submit_diff_review",
      "mcp__linear__merge_diff",
      "mcp__linear__update_diff",
      "mcp__linear__resolve_diff_thread",
      "mcp__linear__share_issue",
      "mcp__linear__create_attachment",
      "mcp__linear__delete_comment",
      "mcp__linear__delete_attachment",
      "mcp__linear__delete_status_update",
      "Edit(~/.claude/settings.json)",
      "Write(~/.claude/settings.json)",
      "Edit(**/CLAUDE.md)",
      "Write(**/CLAUDE.md)",
      "Edit(**/AGENTS.md)",
      "Write(**/AGENTS.md)",
      "Edit(~/.claude/CLAUDE.md)",
      "Write(~/.claude/CLAUDE.md)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.secret.exs)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git stash)",
      "Bash(git stash pop:*)",
      "Bash(mix clean:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(mix test:*)",
      "Bash(mix credo:*)",
      "Bash(mix format --check-formatted:*)",
      "Bash(mix compile:*)",
      "mcp__linear__get_issue",
      "mcp__linear__get_issue_status",
      "mcp__linear__get_project",
      "mcp__linear__get_document",
      "mcp__linear__get_team",
      "mcp__linear__get_user",
      "mcp__linear__get_milestone",
      "mcp__linear__get_initiative",
      "mcp__linear__get_attachment",
      "mcp__linear__get_diff",
      "mcp__linear__get_diff_threads",
      "mcp__linear__get_status_updates",
      "mcp__linear__get_template",
      "mcp__linear__get_workspace",
      "mcp__linear__list_issues",
      "mcp__linear__list_comments",
      "mcp__linear__list_projects",
      "mcp__linear__list_teams",
      "mcp__linear__list_users",
      "mcp__linear__list_cycles",
      "mcp__linear__list_documents",
      "mcp__linear__list_issue_statuses",
      "mcp__linear__list_issue_labels",
      "mcp__linear__list_milestones",
      "mcp__linear__list_diffs",
      "mcp__linear__list_initiatives",
      "mcp__linear__list_templates",
      "mcp__linear__search_documentation"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-settings.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/commit-ticket.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/test-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/gettext-guard.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/mix-format.sh"
          }
        ]
      }
    ]
  }
}
