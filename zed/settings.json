// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "languages": {
    "Elixir": {
      "inlay_hints": {
        "show_value_hints": false,
        "enabled": false,
      },
      "language_servers": ["lexical", "!next-ls", "!elixir-ls", "..."],
    },
    "HEEx": {
      "language_servers": ["lexical", "!next-ls", "!elixir-ls", "..."],
    },
  },
  "ui_font_family": "Al Bayan",
  "ui_font_weight": 550.0,
  "edit_predictions": {
    "mode": "subtle",
  },
  "project_panel": {
    "dock": "right",
  },
  "vim_mode": true,
  "ui_font_size": 12.0,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
}
