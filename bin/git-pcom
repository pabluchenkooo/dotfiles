#!/usr/bin/env bash
  set -euo pipefail

  # Detect if a message was explicitly provided
  has_message=0
  for arg in "$@"; do
    case "$arg" in
      -m|--message|-F|--file|-c|-C|--reuse-message|--fixup|--squash)
        has_message=1
        break
        ;;
    esac
  done

  # Run validations first
  mix compile || fail "mix compile"
  mix format  || fail "mix format"
  mix test    || fail "mix test"

  # If user provided a message (or file/etc.), just commit
  if [ "$has_message" -eq 1 ]; then
    git commit "$@"
    exit $?
  fi

  # Ensure there is a staged diff
  DIFF="$(git diff --cached)"
  if [ -z "$DIFF" ]; then
    echo "No staged changes. Aborting." >&2
    exit 1
  fi

  if [ -z "${OPENAI_API_KEY:-}" ]; then
    echo "OPENAI_API_KEY not set. Use -m or set the key." >&2
    exit 1
  fi

  PROMPT="Generate a single-line Git commit message (max 72 chars) for this diff:
  \n\n$DIFF"

  RESPONSE="$(curl -sS https://api.openai.com/v1/responses \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $OPENAI_API_KEY" \
    -d "$(jq -n --arg input "$PROMPT" '{
          model: "gpt-5",
          input: $input
        }')")"

  COMMIT_MSG="$(echo "$RESPONSE" | jq -r '
    [ .output[]?.content[]? | select(.type=="output_text") | .text ] | join("\n")
  ' | head -n 1 | tr -d "\r")"

  if [ -z "$COMMIT_MSG" ] || [ "$COMMIT_MSG" = "null" ]; then
    echo "Failed to generate commit message." >&2
    exit 1
  fi

  git commit -e -m "$COMMIT_MSG" "$@"
