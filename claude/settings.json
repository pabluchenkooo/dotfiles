{
  "model": "opus[1m]",
  "effortLevel": "high",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "vim",
  "teammateMode": "tmux",
  "preferences": {
    "tmuxSplitPanes": true
  }
}
